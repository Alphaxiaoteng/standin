# StandIn 环境变量示例（复制为 .env 后按需填写；全部可省略）

# Agent 收款地址：链上结算确认（T5）必需；不配置则第三方悬赏保持 pending
STANDIN_AGENT_ADDRESS=

# Monad 测试网 RPC（默认 https://testnet-rpc.monad.xyz）
NEXT_PUBLIC_MONAD_RPC_URL=

# ERC-8004 身份注册私钥（T6，可选）：配置后可注册 Agent 身份
STANDIN_AGENT_PRIVATE_KEY=

# ERC-8004 声誉反馈私钥（T6，可选）：以买方身份提交反馈；合约禁止 Agent 自评
STANDIN_FEEDBACK_PRIVATE_KEY=
